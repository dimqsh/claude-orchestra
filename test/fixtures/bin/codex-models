#!/usr/bin/env node
const { appendFileSync } = require('node:fs');
const { basename } = require('node:path');
const args = process.argv.slice(2);
const command = basename(process.argv[1]);
function log(stage) {
  if (process.env.DISCOVERY_LOG) appendFileSync(process.env.DISCOVERY_LOG,
    JSON.stringify({ command, args, stage, time: Date.now() }) + '\n');
}
log('start');
setTimeout(() => {
  log('end');
  if (command !== 'codex') { console.error('must never be probed'); process.exitCode = 1; return; }
  if (JSON.stringify(args) === JSON.stringify(['debug', 'models'])) {
    if (process.env.CODEX_LIST_ERROR) { console.error(process.env.CODEX_LIST_ERROR); process.exitCode = 1; return; }
    console.log(process.env.CODEX_MODELS || JSON.stringify({ models: [
      { slug: 'gpt-6.1-sol', description: 'Codex hand', visibility: 'list', supported_reasoning_levels: [{ effort: 'low' }, { effort: 'high' }] },
      { slug: 'gpt-reserve', visibility: 'hide', supported_reasoning_levels: [{ effort: 'medium' }] },
    ] }));
  } else if (args[0] === 'exec' && args[1] === '-m' && args[3] === '-s' && args[4] === 'read-only' && args[5] === 'Reply OK' && args.length === 6) {
    if (process.env.CODEX_PROBE_ERROR) { console.error(process.env.CODEX_PROBE_ERROR); process.exitCode = 1; }
    else console.log('OK');
  } else { console.error('unexpected codex arguments'); process.exitCode = 1; }
}, 30);
